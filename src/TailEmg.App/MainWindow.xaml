<Window x:Class="TailEmg.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TailEMG PoC (Milestone A: Fake → OSC)" Width="520" Height="760"
        Closing="Window_Closing">
    <Window.Resources>
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Padding" Value="6"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="10">

            <GroupBox Header="Fake Input">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="60"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Mode"/>
                    <ComboBox Grid.Column="1" Grid.ColumnSpan="2" ItemsSource="{Binding InputModes}" SelectedItem="{Binding InputMode}" Margin="0,2"/>
                    <TextBlock Grid.Row="1" Text="Manual (0-4095)"/>
                    <Slider Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="4095" Value="{Binding ManualValue}"
                            IsEnabled="{Binding IsManual}" VerticalAlignment="Center"/>
                    <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding ManualValue, StringFormat={}{0:0}}" HorizontalAlignment="Right"/>
                    <TextBlock Grid.Row="2" Text="Sine period (s)"/>
                    <TextBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding SinePeriodSeconds, UpdateSourceTrigger=PropertyChanged}"/>
                    <StackPanel Grid.Row="3" Grid.ColumnSpan="3" Orientation="Horizontal" Margin="0,6,0,0">
                        <Button Content="Start" Command="{Binding StartCommand}" Width="80" Margin="0,0,6,0"/>
                        <Button Content="Stop" Command="{Binding StopCommand}" Width="80" Margin="0,0,12,0"/>
                        <TextBlock Text="{Binding Status}"/>
                    </StackPanel>
                </Grid>
            </GroupBox>

            <GroupBox Header="Calibration (manual entry; REST/MAX capture comes in Milestone D)">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition/><RowDefinition/><RowDefinition/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="REST"/>
                    <TextBox Grid.Column="1" Text="{Binding Rest, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Grid.Row="1" Text="MAX"/>
                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Max, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Foreground="Red" Text="{Binding CalibrationWarning}"/>
                </Grid>
            </GroupBox>

            <GroupBox Header="Processing">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Deadzone"/>
                    <TextBox Grid.Column="1" Text="{Binding Deadzone, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Grid.Row="1" Text="Curve"/>
                    <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding Curves}" SelectedItem="{Binding Curve}" Margin="0,2"/>
                    <TextBlock Grid.Row="2" Text="Gamma"/>
                    <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Gamma, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Grid.Row="3" Text="Smoothing (α)"/>
                    <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding Smoothing, UpdateSourceTrigger=PropertyChanged}"/>
                </Grid>
            </GroupBox>

            <GroupBox Header="Output">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="70"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Raw"/>
                    <TextBlock Grid.Column="1" Text="{Binding Raw, StringFormat={}{0:0.00}}"/>
                    <TextBlock Grid.Row="1" Text="Normalized"/>
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Normalized, StringFormat={}{0:0.000}}"/>
                    <ProgressBar Grid.Row="1" Grid.Column="2" Height="10" Maximum="1" Value="{Binding Normalized, Mode=OneWay}"/>
                    <TextBlock Grid.Row="2" Text="Filtered"/>
                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Filtered, StringFormat={}{0:0.000}}"/>
                    <ProgressBar Grid.Row="2" Grid.Column="2" Height="10" Maximum="1" Value="{Binding Filtered, Mode=OneWay}"/>
                    <TextBlock Grid.Row="3" Text="OSC"/>
                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding OscOutput, StringFormat={}{0:0.000}}"/>
                    <ProgressBar Grid.Row="3" Grid.Column="2" Height="10" Maximum="1" Value="{Binding OscOutput, Mode=OneWay}"/>
                </Grid>
            </GroupBox>

            <GroupBox Header="OSC">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Host"/>
                    <TextBox Grid.Column="1" Text="{Binding OscHost, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Grid.Row="1" Text="Port"/>
                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding OscPort, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Grid.Row="2" Text="Address"/>
                    <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding OscAddress, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Grid.Row="3" Text="Rate (Hz)"/>
                    <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding OscRateHz, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Applied on next Start"/>
                    <CheckBox Grid.Row="4" Grid.ColumnSpan="2" Content="OSC Enabled" IsChecked="{Binding OscEnabled}" Margin="0,4"/>
                    <TextBlock Grid.Row="5" Grid.ColumnSpan="2" Foreground="Red" Text="{Binding OscError}" TextWrapping="Wrap"/>
                </Grid>
            </GroupBox>

        </StackPanel>
    </ScrollViewer>
</Window>
