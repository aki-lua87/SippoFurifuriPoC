<Window x:Class="TailEmg.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TailEMG PoC" Width="620" Height="900"
        Closing="Window_Closing">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Padding" Value="6"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="10">

            <GroupBox Header="Input Source">
                <ComboBox ItemsSource="{Binding InputSources}" SelectedItem="{Binding InputSource}"
                          IsEnabled="{Binding CanChangeSource}"/>
            </GroupBox>

            <GroupBox Header="Fake Input" Visibility="{Binding IsFakeSource, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="60"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Mode"/>
                    <ComboBox Grid.Column="1" Grid.ColumnSpan="2" ItemsSource="{Binding InputModes}" SelectedItem="{Binding InputMode}" Margin="0,2"/>
                    <TextBlock Grid.Row="1" Text="Manual (0-4095)"/>
                    <Slider Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="4095" Value="{Binding ManualValue}"
                            IsEnabled="{Binding IsManual}" VerticalAlignment="Center"/>
                    <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding ManualValue, StringFormat={}{0:0}}" HorizontalAlignment="Right"/>
                    <TextBlock Grid.Row="2" Text="Sine period (s)"/>
                    <TextBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding SinePeriodSeconds, UpdateSourceTrigger=PropertyChanged}"/>
                    <StackPanel Grid.Row="3" Grid.ColumnSpan="3" Orientation="Horizontal" Margin="0,6,0,0">
                        <Button Content="Start" Command="{Binding StartCommand}" Width="80" Margin="0,0,6,0"/>
                        <Button Content="Stop" Command="{Binding StopCommand}" Width="80" Margin="0,0,12,0"/>
                        <TextBlock Text="{Binding Status}"/>
                    </StackPanel>
                </Grid>
            </GroupBox>

            <GroupBox Header="MyoWare BLE" Visibility="{Binding IsBleSource, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <Button Content="{Binding ScanButtonText}" Command="{Binding ScanCommand}" Width="90" Margin="0,0,6,0"/>
                        <Button Content="Connect" Command="{Binding ConnectCommand}" Width="90" Margin="0,0,6,0"/>
                        <Button Content="Disconnect" Command="{Binding DisconnectCommand}" Width="90"/>
                    </StackPanel>
                    <ListBox ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice}"
                             DisplayMemberPath="Display" FontFamily="Consolas" FontSize="12" Height="140"
                             IsEnabled="{Binding CanChangeSource}"/>
                    <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="Status"/>
                        <TextBlock Grid.Column="1" Text="{Binding BleStateText}" FontWeight="Bold"/>
                        <TextBlock Grid.Row="1" Text="Device"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding BleDeviceName}"/>
                        <TextBlock Grid.Row="2" Text="Raw"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Raw, StringFormat={}{0:0.00}}" FontFamily="Consolas"/>
                        <TextBlock Grid.Row="3" Text="Last Sample"/>
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding LastSampleText}" FontFamily="Consolas"/>
                        <TextBlock Grid.Row="4" Text="Notify rate"/>
                        <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding NotificationRateText}" FontFamily="Consolas"/>
                        <TextBlock Grid.Row="5" Grid.ColumnSpan="2" Foreground="Red" TextWrapping="Wrap" Text="{Binding BleError}"/>
                    </Grid>
                </StackPanel>
            </GroupBox>

            <Expander Header="BLE Diagnostic" IsExpanded="True" Margin="0,0,0,8"
                      Visibility="{Binding IsBleSource, Converter={StaticResource BoolToVis}}">
                <StackPanel Margin="0,4,0,0">
                    <Button Content="GATT Discover (selected device)" Command="{Binding DiscoverCommand}"
                            HorizontalAlignment="Left" Padding="10,2"/>
                    <TextBox Text="{Binding GattReportText, Mode=OneWay}" IsReadOnly="True" FontFamily="Consolas" FontSize="11"
                             Height="170" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
                    <DockPanel Margin="0,6,0,0">
                        <CheckBox DockPanel.Dock="Right" Content="Pause log" IsChecked="{Binding PauseLog}"/>
                        <TextBlock Text="Notifications (newest first)"/>
                    </DockPanel>
                    <TextBox Text="{Binding NotificationLog, Mode=OneWay}" IsReadOnly="True" FontFamily="Consolas" FontSize="11"
                             Height="170" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
                </StackPanel>
            </Expander>

            <GroupBox Header="Calibration (manual entry; REST/MAX capture comes in Milestone D)">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition/><RowDefinition/><RowDefinition/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="REST"/>
                    <TextBox Grid.Column="1" Text="{Binding Rest, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Grid.Row="1" Text="MAX"/>
                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Max, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Foreground="Red" Text="{Binding CalibrationWarning}"/>
                </Grid>
            </GroupBox>

            <GroupBox Header="Processing">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Deadzone"/>
                    <TextBox Grid.Column="1" Text="{Binding Deadzone, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Grid.Row="1" Text="Curve"/>
                    <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding Curves}" SelectedItem="{Binding Curve}" Margin="0,2"/>
                    <TextBlock Grid.Row="2" Text="Gamma"/>
                    <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Gamma, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Grid.Row="3" Text="Smoothing (α/33ms)" ToolTip="Per-frame (33 ms) coefficient; rescaled by real elapsed time, so independent of input rate"/>
                    <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding Smoothing, UpdateSourceTrigger=PropertyChanged}"/>
                </Grid>
            </GroupBox>

            <GroupBox Header="Output">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="70"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Raw"/>
                    <TextBlock Grid.Column="1" Text="{Binding Raw, StringFormat={}{0:0.00}}"/>
                    <TextBlock Grid.Row="1" Text="Normalized"/>
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Normalized, StringFormat={}{0:0.000}}"/>
                    <ProgressBar Grid.Row="1" Grid.Column="2" Height="10" Maximum="1" Value="{Binding Normalized, Mode=OneWay}"/>
                    <TextBlock Grid.Row="2" Text="Filtered"/>
                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Filtered, StringFormat={}{0:0.000}}"/>
                    <ProgressBar Grid.Row="2" Grid.Column="2" Height="10" Maximum="1" Value="{Binding Filtered, Mode=OneWay}"/>
                    <TextBlock Grid.Row="3" Text="OSC"/>
                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding OscOutput, StringFormat={}{0:0.000}}"/>
                    <ProgressBar Grid.Row="3" Grid.Column="2" Height="10" Maximum="1" Value="{Binding OscOutput, Mode=OneWay}"/>
                </Grid>
            </GroupBox>

            <GroupBox Header="OSC">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Host"/>
                    <TextBox Grid.Column="1" Text="{Binding OscHost, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Grid.Row="1" Text="Port"/>
                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding OscPort, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Grid.Row="2" Text="Address"/>
                    <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding OscAddress, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Grid.Row="3" Text="Rate (Hz)"/>
                    <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding OscRateHz, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Applied on next Start"/>
                    <CheckBox Grid.Row="4" Grid.ColumnSpan="2" Content="OSC Enabled" IsChecked="{Binding OscEnabled}" Margin="0,4"/>
                    <TextBlock Grid.Row="5" Grid.ColumnSpan="2" Foreground="Red" Text="{Binding OscError}" TextWrapping="Wrap"/>
                </Grid>
            </GroupBox>

        </StackPanel>
    </ScrollViewer>
</Window>
